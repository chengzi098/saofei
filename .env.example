# 数据库配置
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# JWT 密钥（请修改为随机字符串）
JWT_SECRET=your_jwt_secret_key_here

# 初始超级管理员密码（仅首次创建 admin 时使用）
ADMIN_INIT_PASSWORD=your_one_time_admin_password_here

# 本地打印代理
PRINT_AGENT_KEY=your_long_random_print_agent_key_here
PRINT_AGENT_ORIGINS=https://www.orangecz.online,https://orangecz.online

# 生产环境配置示例
# 复制此文件为 .env 并填入真实值
# 确保 .env 文件已添加到 .gitignore
